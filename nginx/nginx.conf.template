worker_processes auto;
rtmp_auto_push on;
rtmp_auto_push_reconnect 1s;
events {}
http {
    include       mime.types;
    default_type  application/octet-stream;

    # Cloudflare Real IP (IPv4 only)
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    real_ip_header CF-Connecting-IP;

    # HTTP server for ACME challenges
    server {
        listen 80;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            # Redirect to HTTPS if domain is configured, otherwise serve stats
            # This logic will be handled by docker-entrypoint.sh if SERVER_DOMAIN is set
            root /usr/local/nginx/html;
            index index.html;
        }
    }

    include /etc/nginx/https.conf;

    server {
        listen 8081;

        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /stat.xsl {
            root /usr/local/nginx/html;
        }

        location /login {
            proxy_pass http://127.0.0.1:8080;
        }

        location /callback {
            proxy_pass http://127.0.0.1:8080;
        }

        location /api {
            proxy_pass http://127.0.0.1:8080;
        }

        location /socket.io {
            proxy_pass http://127.0.0.1:8080;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        location / {
            root /usr/local/nginx/html;
            index index.html;
        }
    }
}
rtmp {
    server {
        listen 1935;
        chunk_size ${CHUNK_SIZE};

        # Stability and Security Enhancements
        ping 30s;
        ping_timeout 10s;
        drop_idle_publisher 10s;
        deny play all; # Prevent unauthorized viewing

        # Facebook Application
        application facebook {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name&app=$app;
            push ${FACEBOOK_URL}${FACEBOOK_KEY};
        }

        # Twitch Application
        application twitch {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name&app=$app;
            push ${TWITCH_URL}${TWITCH_KEY};
        }

        # YouTube Application
        application youtube {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name&app=$app;
            push ${YOUTUBE_URL}${YOUTUBE_KEY};
        }

        # Kick Application
        application kick {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name&app=$app;
            push ${KICK_URL}${KICK_KEY};
        }

        # X Application
        application x {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name&app=$app;
            push ${X_URL}${X_KEY};
        }

        # Generic live application for multi-streaming
        application ${APP_NAME} {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name&app=$app;
            on_publish_done http://127.0.0.1:8080/publish_done?key=$name&app=$app;

            {{PUSH_YOUTUBE}}
            {{PUSH_FACEBOOK}}
            {{PUSH_INSTAGRAM}}
            {{PUSH_TIKTOK}}
            {{PUSH_KICK}}
            {{PUSH_X}}
            {{PUSH_TWITCH}}
            {{PUSH_TROVO}}
            {{PUSH_RTMP1}}
            {{PUSH_RTMP2}}
            {{PUSH_RTMP3}}
        }

        application vertical {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name&app=$app;

            {{PUSH_V_YOUTUBE}}
            {{PUSH_V_FACEBOOK}}
            {{PUSH_V_INSTAGRAM}}
            {{PUSH_V_TIKTOK}}
            {{PUSH_V_TIKTOK_DYN}}
            {{PUSH_V_KICK}}
            {{PUSH_V_X}}
            {{PUSH_V_TWITCH}}
            {{PUSH_V_TROVO}}
            {{PUSH_V_RTMP1}}
        }

        application tiktok_relay {
            live on;
            record off;
            exec_push python3 /app/tiktok_pusher.py rtmp://127.0.0.1:1935/tiktok_relay/$name;
        }
    }
}
