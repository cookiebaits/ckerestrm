worker_processes auto;
rtmp_auto_push on;
rtmp_auto_push_reconnect 1s;
events {}

http {
    include       mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout  65;

    # Cloudflare Real IP Configuration
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;

    server {
        listen 8081;

        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /stat.xsl {
            root /usr/local/nginx/html;
        }

        location / {
            root   html;
            index  index.html index.htm;
        }

        # Health check for validator
        location /health {
            proxy_pass http://127.0.0.1:8080/health;
        }
    }
}

rtmp {
    server {
        listen 1935;
        listen [::]:1935 ipv6only=on;
        chunk_size ${CHUNK_SIZE};

        # Stability and Security Enhancements
        ping 30s;
        ping_timeout 10s;
        drop_idle_publisher 10s;
        deny play all; # Prevent unauthorized viewing

        # Specific platform applications (Horizontal)
        application facebook {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate;
            push ${FACEBOOK_URL}${FACEBOOK_KEY};
        }
		
        application twitch {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate;
            push ${TWITCH_URL}${TWITCH_KEY};
        }

        application youtube {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate;
            push ${YOUTUBE_URL}${YOUTUBE_KEY};
        }

        application kick {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate;
            push ${KICK_URL}${KICK_KEY};
        }

        application x {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate;
            push ${X_URL}${X_KEY};
        }

        # Generic live application for multi-streaming (Horizontal)
        application live {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate;
            
            #youtube
            #facebook
            #instagram
            #cloudflare
            #kick
            #x
            #twitch
            #rtmp1
            #rtmp2
            #rtmp3
        }

        # Vertical application for multi-streaming (Vertical)
        application vertical {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate;

            #youtube_vertical
            #twitch_vertical
            #tiktok_vertical
            #kick_vertical
            #rtmp_vertical
        }
    }
}
