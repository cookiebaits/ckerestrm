worker_processes auto;
rtmp_auto_push on;
rtmp_auto_push_reconnect 1s;
events {}
rtmp {
    server {
        listen 1935;
        chunk_size ${CHUNK_SIZE};

        # Stability and Security Enhancements
        ping 30s;
        ping_timeout 10s;
        drop_idle_publisher 10s;
        deny play all; # Prevent unauthorized viewing

        # Facebook Application
        application facebook {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${FACEBOOK_URL}${FACEBOOK_KEY};
        }
		
        # Twitch Application
        application twitch {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${TWITCH_URL}${TWITCH_KEY};
        }

        # YouTube Application
        application youtube {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${YOUTUBE_URL}${YOUTUBE_KEY};
        }

        # TikTok Application
        application tiktok {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${TIKTOK_URL}${TIKTOK_KEY};
        }

        # Kick Application
        application kick {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${KICK_URL}${KICK_KEY};
        }

        # X Application
        application x {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${X_URL}${X_KEY};
        }

        # Vertical Platform Specific Applications
        application tiktok_v {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${TIKTOK_V_URL}${TIKTOK_V_KEY};
        }

        application twitch_v {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${TWITCH_V_URL}${TWITCH_V_KEY};
        }

        application youtube_v {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${YOUTUBE_V_URL}${YOUTUBE_V_KEY};
        }

        # Vertical application for simultaneous vertical multi-streaming
        application vertical {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;

            #tiktok_v
            #twitch_v
            #youtube_v
        }

        # Generic live application for multi-streaming
        application live {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            
            #youtube
            #facebook
            #instagram
            #cloudflare
            #kick
            #x
            #twitch
            #tiktok
        }
    }
}
